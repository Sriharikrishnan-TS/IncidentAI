# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend
PORT=8080
AI_ENGINE_URL=http://localhost:8001
REPOS_DIR=./repos

# Backend Security (Callback Authentication)
# IMPORTANT: Set these in production to secure callback endpoints
CALLBACK_API_KEY=your-secure-random-key-here-change-in-production
AI_ENGINE_IP=127.0.0.1

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ChromaDB Configuration
CHROMADB_URL=http://localhost:8001

# AI Engine
AI_ENGINE_PORT=8000

# AI Engine Backend Callback Configuration
# Used by orchestration nodes to send data back to backend
BACKEND_URL=http://localhost:8080
# CALLBACK_API_KEY is shared with backend (defined above)

# Data Services
NEO4J_AUTH=neo4j/password
CHROMA_PORT=8001
